DB_HOST=localhost
DB_PORT=5432
DB_NAME=database
DB_USER=user
DB_PASSWORD=password
DB_SSLMODE=prefer
# Alternatively, use one complete connection string:
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret-key-1234567890
DEBUG=True
USE_SQLITE=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000
